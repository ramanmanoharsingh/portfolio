rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'ramanmanoharsingh@gmail.com';
    }

    match /leads/{leadId} {
      // Only Raman can view the entire pipeline or change/delete records.
      allow read, update, delete: if isOwner();

      // Clients can read only enquiries associated with their own account.
      // (The owner is also allowed by the rule above.)
      allow get, list: if isOwner()
        || (request.auth != null
          && resource.data.userId == request.auth.uid);

      // Public enquiry form may create a lead, but never read existing leads.
      allow create: if
        request.resource.data.keys().hasOnly([
          'name', 'email', 'whatsapp', 'projectType', 'budgetRange',
          'deadline', 'preferredPayment', 'description', 'status',
          'createdAt', 'updatedAt', 'userId', 'clientEmail'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 15
        && request.resource.data.description.size() <= 5000
        && request.resource.data.status == 'New'
        && request.resource.data.userId == (request.auth == null ? null : request.auth.uid)
        && (!request.auth != null || request.resource.data.clientEmail == request.auth.token.email);
    }
  }
}